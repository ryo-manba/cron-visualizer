{
  "name": "cron-visualizer",
  "version": "0.1.0",
  "private": true,
  "description": "A react app to visualize cron expressions",
  "keywords": [
    "react",
    "cron",
    "cron expression",
    "cron visualizer"
  ],
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm build:wasm && pnpm build:web",
    "build:web": "pnpm typecheck && vite build",
    "build:wasm": "cd cron-wasm && wasm-pack build --target web --locked",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:wasm": "cd cron-wasm && cargo test --locked",
    "lint": "eslint src",
    "format": "prettier --write 'src/**/*.{js,ts,tsx}'"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "cron-parser": "^4.9.0",
    "moment-timezone": "^0.5.48",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^4.12.0",
    "react-tooltip": "^5.30.0",
    "recharts": "^2.15.4",
    "web-vitals": "2.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.2",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^7.0.1"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@11.1.1",
  "volta": {
    "node": "22.22.2"
  }
}
